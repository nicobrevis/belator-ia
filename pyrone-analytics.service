[Unit]
Description=PYRONE Analytics Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=belator
Group=belator
WorkingDirectory=/home/belator/Desktop/PyrOne/IA Belator
Environment=PYRONE_IA_HOST=0.0.0.0
Environment=PYRONE_IA_PORT=8765
Environment=PYRONE_INFERENCE_DEVICE=0
Environment=PYRONE_PROCESSED_RTSP_HOST=127.0.0.1
Environment=PYRONE_PROCESSED_RTSP_PORT=8554
Environment=PYRONE_PROCESSED_RTSP_ENABLED=true
Environment=PYRONE_PROCESSED_RTSP_BITRATE=2500k
Environment=PYRONE_PROCESSED_RTSP_BUFSIZE=5000k
Environment=PYRONE_PROCESSED_RTSP_PRESET=veryfast
Environment=PYRONE_PROCESSED_PUBLISH_TRANSPORT=rtmp
Environment=PYRONE_PROCESSED_RTMP_URL_TEMPLATE=rtmp://192.168.210.84:1935/processed/{droneId}
Environment=PYRONE_PROCESSED_PUBLISH_MAX_FPS=20
Environment=PYRONE_PROCESSED_RTSP_WRITE_TIMEOUT_SECONDS=8
Environment=PYRONE_PROCESSED_PUBLISH_STARTUP_TIMEOUT_SECONDS=25
Environment=PYRONE_PROCESSED_PUBLISH_READY_AFTER_SECONDS=2
Environment=PYRONE_PROCESSED_PUBLISH_READY_FRESHNESS_SECONDS=2
Environment=PYRONE_PROCESSED_PUBLISH_STABLE_RESET_SECONDS=20
Environment=PYRONE_PROCESSED_PUBLISH_RETRY_SECONDS=2
Environment=PYRONE_PROCESSED_PUBLISH_RETRY_MAX_SECONDS=30
Environment=PYRONE_PROCESSED_PUBLISH_STALE_SECONDS=8
Environment=PYRONE_RTSP_READ_TIMEOUT_SECONDS=5
Environment=PYRONE_CAPTURE_STALL_TIMEOUT_SECONDS=10
Environment=PYRONE_RECONNECT_DELAY_SECONDS=2
Environment=PYRONE_RECONNECT_DELAY_MAX_SECONDS=30
Environment=PYRONE_SOURCE_STABLE_RESET_SECONDS=10
Environment=PYRONE_MODEL_RETRY_SECONDS=2
Environment=PYRONE_MODEL_RETRY_MAX_SECONDS=30
Environment=PYRONE_LEGACY_MJPEG_ENABLED=true
Environment=PYRONE_PREVIEW_JPEG_QUALITY=92
EnvironmentFile=-/etc/pyrone/analytics.env
ExecStart=/usr/bin/bash -lc 'cd "/home/belator/Desktop/PyrOne/IA Belator" && exec /usr/bin/python3 -m service.main'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
